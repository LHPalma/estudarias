// Estudarias — schema alvo da v1
//
// Nomes de tabelas e colunas em inglês (snake_case, no singular). As tabelas de identidade (student, app_user e refresh_token) já
// estão em inglês e batem com a migration; as demais, ainda em português, passam para o inglês quando forem mapeadas (#42).

Enum experimental_group {
  control
  diagnostic
}

Enum user_role {
  student
}

Enum dificuldade {
  facil
  medio
  dificil
}

Enum origem_flashcard {
  manual
  gerado_por_erro
}

// ---------- Conteúdo (vem do seed) ----------

Table topico {
  id uuid [pk]
  nome "varchar(100)" [not null]
  slug "varchar(100)" [not null, unique, note: 'minúsculas, dígitos e hífens entre grupos: ^[a-z0-9]+(-[a-z0-9]+)*$']
}

Table pre_requisito {
  topico_id uuid [not null, ref: > topico.id, note: 'tópico que exige']
  requisito_id uuid [not null, ref: > topico.id, note: 'tópico exigido']

  indexes {
    (topico_id, requisito_id) [pk]
  }

  Note: 'CHECK (topico_id <> requisito_id). Ciclos são barrados pelo validador do seed.'
}

Table tipo_erro {
  id uuid [pk]
  codigo varchar [not null]
  nome varchar [not null]
  descricao text
  feedback text [not null]
  topico_id uuid [not null, ref: > topico.id]

  indexes {
    (topico_id, codigo) [unique]
  }
}

Table licao {
  id uuid [pk]
  topico_id uuid [not null, ref: > topico.id]
  ordem int [not null]
  titulo varchar [not null]
  conteudo text [not null]

  indexes {
    (topico_id, ordem) [unique]
  }
}

Table exercicio {
  id uuid [pk]
  licao_id uuid [not null, ref: > licao.id]
  enunciado text [not null]
  dificuldade dificuldade [not null]
}

Table alternativa {
  id uuid [pk]
  exercicio_id uuid [not null, ref: > exercicio.id]
  texto text [not null]
  correta boolean [not null]
  tipo_erro_id uuid [null, ref: > tipo_erro.id, note: 'NULL se correta']

  Note: '''
    CHECK ((correta AND tipo_erro_id IS NULL) OR (NOT correta AND tipo_erro_id IS NOT NULL)).
    Índice único parcial em (exercicio_id) WHERE correta = true: no máximo 1 correta por exercício.
    "Pelo menos 1 correta" e "tipo_erro do mesmo tópico do exercício" ficam no validador do seed.
  '''
}

// ---------- Identidade (autenticação) ----------

Table app_user {
  id uuid [pk]
  email "varchar(254)" [not null, unique, note: 'aparado e em minúsculas; é o que a conta usa para entrar. Índice ux_app_user_email']
  password_hash text [not null, note: 'texto PHC do Argon2id; o pepper não aparece nele']
  password_pepper_version int [not null, note: 'versão do pepper que derivou o hash; o login refaz o hash se não for a corrente']
  role user_role [not null, note: 'só student por ora']
  student_id uuid [null, unique, ref: - student.id, note: 'uma conta por aluno. Índice ux_app_user_student_id. Nulo para papéis futuros sem aluno. ON DELETE RESTRICT']
  is_active boolean [not null, note: 'conta desabilitada não entra nem renova a sessão']

  Note: '''
    A conta de acesso, separada do aluno de propósito. A tabela se chama app_user porque user é palavra reservada do PostgreSQL.
    Constraint ck_app_user_role: CHECK (role IN ('student')).
  '''
}

Table refresh_token {
  id uuid [pk]
  user_id uuid [not null, ref: > app_user.id, note: 'ON DELETE CASCADE: sem a conta, o token não tem sentido']
  family_id uuid [not null, note: 'todos os tokens que descendem de um login']
  token_hash "char(64)" [not null, unique, note: 'SHA-256 em hexadecimal do token cru; o valor cru nunca é guardado. Índice ux_refresh_token_token_hash']
  expires_at timestamptz [not null, note: 'emissão + 30 dias']
  revoked_at timestamptz [null, note: 'nulo enquanto ativo. É o token de concorrência: de duas renovações simultâneas do mesmo token, só o UPDATE da primeira acha a linha não revogada']
  replaced_by_token_id uuid [null, note: 'o sucessor, quando a revogação veio de rotação; nulo quando veio de logout ou de reuso']

  indexes {
    user_id [name: 'ix_refresh_token_user_id']
    family_id [name: 'ix_refresh_token_family_id']
  }

  Note: 'Uso único e rotativo, com família: um token já revogado que reaparece revoga a família inteira.'
}

// ---------- Aluno e progresso ----------

Table student {
  id uuid [pk]
  name "varchar(100)" [not null]
  experimental_group experimental_group [not null, note: 'gravado em minúsculas (control, diagnostic); fixado no cadastro e nunca muda']

  Note: '''
    Perfil de estudo: quem estuda e é medido no experimento. Não guarda e-mail nem senha (isso é da conta, app_user).
    Constraint ck_student_experimental_group: CHECK (experimental_group IN ('control', 'diagnostic')).
  '''
}

Table aluno_topico {
  id uuid [pk]
  aluno_id uuid [not null, ref: > student.id]
  topico_id uuid [not null, ref: > topico.id]
  desbloqueado_em timestamptz [not null, note: 'fato gravado; uma vez preenchido, nunca volta a bloquear']
  dominado_em timestamptz [null, note: 'primeira vez que o aluno dominou o tópico; null = disponível']

  indexes {
    (aluno_id, topico_id) [unique]
  }

  Note: '''
    A linha só existe a partir do desbloqueio: tópico sem linha está bloqueado.
    Status derivado: dominado_em IS NULL = disponível; preenchido = dominado.
  '''
}

Table tentativa {
  id uuid [pk]
  aluno_id uuid [not null, ref: > student.id]
  exercicio_id uuid [not null, ref: > exercicio.id]
  alternativa_id uuid [not null, ref: > alternativa.id]
  tempo_resposta_seg int [null]
  timestamp timestamptz [not null]

  indexes {
    (aluno_id, exercicio_id)
  }
}

// ---------- Flashcards e revisão (SM-2) ----------

Table flashcard {
  id uuid [pk]
  topico_id uuid [not null, ref: > topico.id]
  pergunta text [not null]
  resposta text [not null]
  origem origem_flashcard [not null]
  tipo_erro_id uuid [null, ref: > tipo_erro.id, note: 'preenchido quando origem = gerado_por_erro']

  Note: '''
    Global por tipo_erro: um único flashcard gerado_por_erro por tipo_erro.
    Índice único parcial em (tipo_erro_id) WHERE origem = 'gerado_por_erro'.
    CHECK ((origem = 'gerado_por_erro') = (tipo_erro_id IS NOT NULL)).
  '''
}

Table aluno_flashcard {
  aluno_id uuid [not null, ref: > student.id]
  flashcard_id uuid [not null, ref: > flashcard.id]
  proxima_revisao timestamptz [not null]
  repeticoes int [not null, default: 0, note: 'SM-2: acertos consecutivos; zera ao errar']
  intervalo int [not null, note: 'em dias']
  fator_facilidade "numeric(4,2)" [not null, default: 2.5, note: 'SM-2, inicia em 2.5, mínimo 1.3']
  tentativa_origem_id uuid [null, ref: > tentativa.id, note: 'primeira tentativa que gerou este cartão para o aluno']

  indexes {
    (aluno_id, flashcard_id) [pk]
    (aluno_id, proxima_revisao)
  }
}

// ---------- Records: dados de exemplo (Frações) ----------

Records topico(id, nome, slug) {
  '0192f0c4-0001-7000-8000-000000000001', 'Equações do 1º grau', 'equacoes-1-grau'
  '0192f0c4-0001-7000-8000-000000000002', 'Frações', 'fracoes'
  '0192f0c4-0001-7000-8000-000000000003', 'Operações básicas', 'operacoes-basicas'
  '0192f0c4-0001-7000-8000-000000000004', 'Porcentagem', 'porcentagem'
}

