  '0192f0c4-0007-7000-8000-000000000002', '0192f0c4-0006-7000-8000-000000000001', '0192f0c4-0001-7000-8000-000000000002', '2026-10-07 10:05:00-03', null
}

Records tentativa(id, aluno_id, exercicio_id, alternativa_id, tempo_resposta_seg, timestamp) {
