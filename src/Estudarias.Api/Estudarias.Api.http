@Estudarias.Api_HostAddress = http://localhost:5007

GET {{Estudarias.Api_HostAddress}}/health

###

GET {{Estudarias.Api_HostAddress}}/openapi/v1.json
Accept: application/json

###

# Autenticação. Cadastre, copie o refreshToken e o accessToken da resposta para as variáveis abaixo e chame os demais.

@refreshToken = cole-aqui-o-refreshToken
@accessToken = cole-aqui-o-accessToken

POST {{Estudarias.Api_HostAddress}}/auth/register
Content-Type: application/json

{
  "name": "Ana",
  "email": "ana@example.com",
  "password": "Senha-valida-1!"
}

###

POST {{Estudarias.Api_HostAddress}}/auth/login
Content-Type: application/json

{
  "email": "ana@example.com",
  "password": "Senha-valida-1!"
}

###

POST {{Estudarias.Api_HostAddress}}/auth/refresh
Content-Type: application/json

{
  "refreshToken": "{{refreshToken}}"
}

###

POST {{Estudarias.Api_HostAddress}}/auth/logout
Content-Type: application/json

{
  "refreshToken": "{{refreshToken}}"
}

###

# O perfil de quem está logado: a conta e o aluno ligado a ela. Exige o access token (Authorization: Bearer).
GET {{Estudarias.Api_HostAddress}}/me
Authorization: Bearer {{accessToken}}

###

# Qualquer outro endpoint exige o access token (Authorization: Bearer).
GET {{Estudarias.Api_HostAddress}}/qualquer-endpoint-protegido
Authorization: Bearer {{accessToken}}

###
